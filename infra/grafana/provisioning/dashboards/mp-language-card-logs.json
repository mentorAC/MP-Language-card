{
  "uid": "mp-lc-logs",
  "title": "MP Language Card — Логи",
  "tags": ["logs", "loki", "mp-language-card"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "label": "Контейнер",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(container)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      },
      {
        "name": "level",
        "label": "Уровень",
        "type": "custom",
        "query": "error,warn,info,debug,unknown",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "options": [
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "debug", "value": "debug" },
          { "selected": false, "text": "unknown", "value": "unknown" }
        ],
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "search",
        "label": "Поиск в строке",
        "type": "textbox",
        "query": ".*",
        "current": { "selected": false, "text": ".*", "value": ".*" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Всего строк",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"$search\" | detected_level=~\"$level\" [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "ERROR",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"$search\" | detected_level=\"error\" [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WARN",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({container=~\"$container\"} |~ \"$search\" | detected_level=\"warn\" [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Строк в секунду",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short", "decimals": 2 },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(rate({container=~\"$container\"} |~ \"$search\" | detected_level=~\"$level\" [$__range]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Динамика по уровням",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 5 },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "unknown" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detected_level) (rate({container=~\"$container\"} |~ \"$search\" | detected_level=~\"$level\" [$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Распределение по уровням",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "showLegend": true, "values": ["value"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (detected_level) (count_over_time({container=~\"$container\"} |~ \"$search\" | detected_level=~\"$level\" [$__range]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Объём логов по контейнерам",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate({container=~\"$container\"} |~ \"$search\" [$__auto]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ошибки по контейнерам",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate({container=~\"$container\"} |~ \"$search\" | detected_level=\"error\" [$__auto]))",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Поток логов",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 22 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"$container\"} |~ \"$search\" | detected_level=~\"$level\"",
          "maxLines": 1000
        }
      ]
    }
  ]
}
